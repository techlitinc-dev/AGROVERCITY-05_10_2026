# Base URL of the backend API. The /v1 prefix is part of the base URL.
# Default uses the Vite dev proxy (vite.config.ts forwards /v1 to VITE_BACKEND_ORIGIN).
VITE_API_BASE_URL=/v1
# Optional: only needed for the farm-map step. Without a key the map shows an
# honest disabled fallback (same rule as the mobile app) and nothing is submitted.
VITE_GOOGLE_MAPS_API_KEY=
# Firebase web SDK config (values from Firebase console > project settings > web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
# reCAPTCHA v3 site key for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Sentry DSN for the website (leave empty in dev).
VITE_SENTRY_DSN=
