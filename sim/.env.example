# Copy to .env (gitignored) or export in your shell.
# Any OpenAI-compatible provider works.

# Default: DeepSeek (deepseek-flash, off-peak $0.15/M in, $0.60/M out)
DEEPSEEK_API_KEY=

# Alternative: Kimi Code membership key (OpenAI-compatible)
# OPENAI_BASE_URL=https://api.kimi.ai/coding/v1
# OPENAI_API_KEY=sk-kimi-...
# SIM_MODEL=kimi-for-coding-highspeed
# Cheapest→strongest: kimi-for-coding-highspeed (K2.7) < kimi-for-coding (K2.8) < k3-256k < k3
# (Kimi Code models accept only temperature=1 — harness handles it; keep llm_max_tokens ≥ 600
#  because reasoning tokens share the budget)

# Override backend target (localhost enforced for safety by default)
# SIM_BACKEND_URL=http://localhost:8000
