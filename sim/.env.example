# Copy to .env (gitignored) or export in your shell.
# Any OpenAI-compatible provider works.

# Default: DeepSeek (deepseek-flash, off-peak $0.15/M in, $0.60/M out)
DEEPSEEK_API_KEY=

# Alternative: Kimi / Moonshot (OpenAI-compatible)
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
# OPENAI_API_KEY=
# SIM_MODEL=<kimi model id — check their docs>

# Override backend target (localhost enforced for safety by default)
# SIM_BACKEND_URL=http://localhost:8000
