{
  "api": {
    "name": "AGROVERCITY / Kisan Setu Backend API",
    "baseUrl": "https://api.agrovercity.in/v1",
    "auth": "OTP-verified session -> JWT Bearer access token + refresh token; MPIN as second factor for sensitive actions",
    "conventions": {
      "languageHeader": "Accept-Language: hi|mr|gu|pa|te|ta|en",
      "idempotency": "Idempotency-Key header on all writes; offline clients replay via POST /sync",
      "pagination": "?page=&pageSize= ; envelope { data, page, pageSize, total }",
      "errorFormat": "{ error: { code, message, fieldErrors } }",
      "roleEnforcement": "Server enforces same ACL as profile_routes.dart"
    }
  },
  "endpoints": [
    {"group": "auth", "method": "POST", "path": "/auth/otp/send", "description": "Send OTP to mobile", "roles": ["public"], "request": {"phone": "string"}, "response": {"otpSessionId": "string", "expiresInSec": 300, "resendAfterSec": 30}, "source": "AppState.loginWithPhone"},
    {"group": "auth", "method": "POST", "path": "/auth/otp/verify", "description": "Verify OTP, returns session", "roles": ["public"], "request": {"phone": "string", "otp": "string", "otpSessionId": "string"}, "response": {"accessToken": "string", "refreshToken": "string", "isNewUser": "bool", "user": "FarmerProfile"}},
    {"group": "auth", "method": "POST", "path": "/auth/login", "description": "Login with mobile + 4-digit MPIN", "roles": ["public"], "request": {"phone": "string", "mpin": "string"}, "response": {"accessToken": "string", "refreshToken": "string", "user": "FarmerProfile"}, "source": "AppState.loginWithMobileAndMpin"},
    {"group": "auth", "method": "POST", "path": "/auth/mpin/reset", "description": "Reset MPIN via OTP", "roles": ["public"], "request": {"phone": "string", "otp": "string", "otpSessionId": "string", "newMpin": "string"}, "source": "AppState.resetMpinWithOtp"},
    {"group": "auth", "method": "POST", "path": "/auth/biometric", "description": "Biometric login (device-bound key)", "roles": ["public"], "request": {"phone": "string", "deviceKey": "string", "signature": "string"}},
    {"group": "auth", "method": "POST", "path": "/auth/refresh", "description": "Refresh access token", "roles": ["public"], "request": {"refreshToken": "string"}},
    {"group": "auth", "method": "POST", "path": "/auth/logout", "description": "Invalidate session", "roles": ["all"], "source": "AppState.logout"},
    {"group": "auth", "method": "POST", "path": "/auth/register", "description": "Complete registration wizard", "roles": ["public"], "request": {"name": "string", "phone": "string", "state": "string", "district": "string", "tehsil": "string", "village": "string", "landAreaAcres": "double", "soilType": "string", "irrigationType": "string", "crops": ["string"], "mpin": "string", "profiles": ["profileType"], "primaryProfile": "profileType"}, "response": {"user": "FarmerProfile", "accessToken": "string"}, "source": "AppState.completeRegistration"},
    {"group": "profile", "method": "PUT", "path": "/users/me/farm-boundary", "description": "Save farm geofence polygon", "roles": ["farmer"], "request": {"farmBoundaryPoints": [{"lat": "double", "lng": "double"}], "landAreaAcres": "double", "khasraNumber": "string?"}, "source": "AppState.confirmFarmMap"},
    {"group": "profile", "method": "GET", "path": "/users/me", "description": "Full user profile + linkedProfiles + activeProfile", "roles": ["all"], "entity": "FarmerProfile"},
    {"group": "profile", "method": "PUT", "path": "/users/me", "description": "Update profile fields", "roles": ["all"], "entity": "FarmerProfile"},
    {"group": "profile", "method": "POST", "path": "/users/me/profiles", "description": "Link a new profile", "roles": ["all"], "request": {"profileType": "farmer|farmLandlord|transport|seller|equipmentRental|broker"}, "source": "AppState.linkNewProfile"},
    {"group": "profile", "method": "DELETE", "path": "/users/me/profiles/{type}", "description": "Unlink profile (409 if last remaining)", "roles": ["all"], "source": "AppState.unlinkProfile"},
    {"group": "profile", "method": "POST", "path": "/users/me/profiles/{type}/activate", "description": "Switch active profile; returns defaultHomeRoute", "roles": ["all"], "source": "AppState.switchProfile"},
    {"group": "profile", "method": "PUT", "path": "/users/me/profiles/{type}/primary", "description": "Star profile as primary", "roles": ["all"]},
    {"group": "profile", "method": "PUT", "path": "/users/me/settings", "description": "Update language, womenMode, highContrast, darkMode", "roles": ["all"], "request": {"language": "string", "womenMode": "bool", "highContrast": "bool", "darkMode": "bool"}},
    {"group": "profile", "method": "GET", "path": "/users/me/dashboard/{profileType}", "description": "Persona home payload: metrics, quick actions, activity list", "roles": ["all"]},
    {"group": "reference", "method": "GET", "path": "/geo/reverse", "description": "Reverse-geocode for language suggestion", "roles": ["public"], "request": {"query": "lat, lng"}, "response": {"state": "string", "district": "string", "region": "string", "suggestedLanguages": ["string"]}},
    {"group": "reference", "method": "GET", "path": "/regions/crops", "description": "District crop mapping (ICRISAT/State Agri Dept)", "roles": ["public"], "request": {"query": "district"}, "response": {"district": "string", "kharif": ["string"], "rabi": ["string"], "suggested": ["string"]}},
    {"group": "reference", "method": "GET", "path": "/languages", "description": "Supported languages + regional mapping + greeting audioText", "roles": ["public"]},
    {"group": "mandi", "method": "GET", "path": "/mandi/prices", "description": "Live mandi prices (Agmarknet/eNAM)", "roles": ["farmer", "seller", "broker"], "request": {"query": "crop, district, lat, lng, page"}, "entity": "MandiPrice"},
    {"group": "mandi", "method": "GET", "path": "/mandi/vyapari-rates", "description": "Aaj ke Bhav live trader rates (2h refresh 06-20h, offline cached)", "roles": ["farmer", "seller", "broker"], "request": {"query": "crops"}, "entity": "VyapariRate"},
    {"group": "mandi", "method": "GET", "path": "/mandi/compare", "description": "Smart Mandi Selection: net profit after transport per mandi", "roles": ["farmer", "seller", "broker"], "request": {"query": "crop, quantityQuintals, lat, lng"}, "response": [{"mandiName": "string", "modalPrice": "int", "transportCost": "int", "netProfit": "int"}]},
    {"group": "mandi", "method": "GET", "path": "/mandi/list", "description": "Mandi directory", "roles": ["farmer", "seller", "broker"]},
    {"group": "advisory", "method": "POST", "path": "/advisory/saturation", "description": "Market saturation / demand forecast", "roles": ["farmer"], "request": {"crop": "string", "district": "string", "lat": "double", "lng": "double", "radiusKm": "int"}, "response": {"sowingCount": "int", "radiusKm": "int", "expectedArrivalIncrease": "string", "riskLevel": "green|yellow|red", "predictedPrice": "int", "predictedDate": "string", "alternativeCrops": [{"crop": "string", "expectedPrice": "int"}]}, "notes": "Aggregate counts only, opt-in data sharing"},
    {"group": "advisory", "method": "POST", "path": "/advisory/disease-scan", "description": "Leaf disease detection from image (multipart)", "roles": ["farmer"], "entity": "PestDisease"},
    {"group": "advisory", "method": "GET", "path": "/advisory/pest-radar", "description": "Nearby pest outbreak alerts", "roles": ["farmer"], "request": {"query": "lat, lng, radiusKm=5"}},
    {"group": "advisory", "method": "POST", "path": "/advisory/npk", "description": "NPK fertilizer recommendation", "roles": ["farmer"], "request": {"n": "int", "p": "int", "k": "int", "crop": "string", "soilType": "string"}},
    {"group": "chatbot", "method": "POST", "path": "/chatbot/messages", "description": "Send message to Kisan Mitra (text or audio)", "roles": ["all"], "request": {"text": "string?", "audioUrl": "string?", "language": "string", "sessionId": "string"}, "entity": "KisanMitraMessage", "notes": "OpenRouter LLM + Sarvam STT; 24h session memory", "source": "AppState.sendChatbotMessage"},
    {"group": "chatbot", "method": "GET", "path": "/chatbot/history", "description": "Conversation history", "roles": ["all"], "request": {"query": "sessionId"}},
    {"group": "chatbot", "method": "POST", "path": "/chatbot/handoff", "description": "Request human expert (sends chat + farm data)", "roles": ["all"], "request": {"sessionId": "string", "reason": "string"}, "response": {"expertName": "string", "contactChannel": "string", "etaMinutes": "int"}},
    {"group": "misc", "method": "GET", "path": "/weather", "description": "Weather strip + rain radar (IMD/OpenWeather proxy)", "roles": ["all"], "request": {"query": "lat, lng"}},
    {"group": "misc", "method": "POST", "path": "/tasks/urgent/complete", "description": "Mark Today's Action done, awards 50 coins", "roles": ["farmer"], "response": {"agriCoinsEarned": 50, "newBalance": "int"}, "source": "AppState.markUrgentTaskDone"},
    {"group": "marketplace", "method": "GET", "path": "/products", "description": "Agri input product list (seeds/vehicles/fertilizer/pesticide/tools)", "roles": ["farmer", "farmLandlord", "transport", "seller"], "request": {"query": "category, query, lat, lng, page"}, "entity": "InputProduct"},
    {"group": "marketplace", "method": "GET", "path": "/products/{id}", "description": "Product detail", "roles": ["farmer", "farmLandlord", "transport", "seller"], "entity": "InputProduct"},
    {"group": "marketplace", "method": "GET", "path": "/products/{id}/certificate", "description": "QR authenticity certificate (Agmark/Ministry)", "roles": ["farmer", "farmLandlord", "transport", "seller"], "response": {"batchNo": "string", "certifier": "string", "certificateNo": "string", "valid": "bool", "verifiedAt": "string"}},
    {"group": "marketplace", "method": "GET", "path": "/cart", "description": "Get cart", "roles": ["farmer", "farmLandlord", "transport", "seller"], "source": "AppState.cartTotal"},
    {"group": "marketplace", "method": "POST", "path": "/cart/items", "description": "Add to cart", "roles": ["farmer", "farmLandlord", "transport", "seller"], "request": {"productId": "string", "quantity": "int"}, "source": "AppState.addToCart"},
    {"group": "marketplace", "method": "PUT", "path": "/cart/items/{productId}", "description": "Update cart quantity", "roles": ["farmer", "farmLandlord", "transport", "seller"]},
    {"group": "marketplace", "method": "DELETE", "path": "/cart/items/{productId}", "description": "Remove from cart", "roles": ["farmer", "farmLandlord", "transport", "seller"], "source": "AppState.removeFromCart"},
    {"group": "marketplace", "method": "POST", "path": "/orders", "description": "Place order (upi/cod/bnpl)", "roles": ["farmer", "farmLandlord", "transport", "seller"], "request": {"items": [{"productId": "string", "quantity": "int"}], "paymentMethod": "upi|cod|bnpl", "deliveryAddress": "string"}, "response": {"orderId": "string", "total": "int", "bnplSchedule": "array?"}},
    {"group": "marketplace", "method": "GET", "path": "/orders", "description": "Order history", "roles": ["farmer", "farmLandlord", "transport", "seller"]},
    {"group": "marketplace", "method": "GET", "path": "/orders/{id}", "description": "Order detail with delivery status", "roles": ["farmer", "farmLandlord", "transport", "seller"]},
    {"group": "contracts", "method": "GET", "path": "/contracts", "description": "Pre-sowing price-lock contracts", "roles": ["farmer", "seller", "broker"], "request": {"query": "status"}, "entity": "BuyerContract"},
    {"group": "contracts", "method": "GET", "path": "/contracts/{id}", "description": "Contract detail + terms", "roles": ["farmer", "seller", "broker"], "entity": "BuyerContract"},
    {"group": "contracts", "method": "POST", "path": "/contracts/{id}/accept", "description": "E-sign contract acceptance", "roles": ["farmer", "seller"], "request": {"signatureData": "string", "consentTimestamp": "string", "mpin": "string"}, "source": "AppState.acceptContract"},
    {"group": "transport", "method": "GET", "path": "/transport/vehicles", "description": "Bookable vehicle types with base + per-km rates", "roles": ["farmer", "seller", "transport"]},
    {"group": "transport", "method": "POST", "path": "/transport/fare-estimate", "description": "Live fare estimate", "roles": ["farmer", "seller", "transport"], "request": {"vehicleType": "string", "distanceKm": "double"}, "response": {"baseFare": "int", "distanceFare": "int", "totalFare": "int"}},
    {"group": "transport", "method": "POST", "path": "/transport/bookings", "description": "Book agri vehicle", "roles": ["farmer", "seller"], "request": {"vehicleType": "string", "distanceKm": "double", "pickup": "string", "drop": "string", "date": "string"}},
    {"group": "transport", "method": "GET", "path": "/transport/bookings", "description": "Trip list for transporter dashboard", "roles": ["transport"], "request": {"query": "status"}},
    {"group": "transport", "method": "PATCH", "path": "/transport/bookings/{id}", "description": "Update trip status", "roles": ["transport"], "request": {"status": "accepted|enRoute|delivered|cancelled"}},
    {"group": "pnl", "method": "GET", "path": "/pnl/summary", "description": "KPI cards (gross income, cost, net profit)", "roles": ["farmer", "farmLandlord", "seller", "equipmentRental", "broker"]},
    {"group": "pnl", "method": "GET", "path": "/pnl/crops", "description": "Per-crop P&L statements", "roles": ["farmer", "farmLandlord", "seller", "equipmentRental", "broker"], "entity": "CropPandL"},
    {"group": "pnl", "method": "POST", "path": "/pnl/crops/{id}/expenses", "description": "Add expense to crop", "roles": ["farmer", "farmLandlord", "seller", "equipmentRental", "broker"], "request": {"category": "string", "amount": "int"}},
    {"group": "pnl", "method": "POST", "path": "/pnl/break-even", "description": "Pre-sowing break-even calculator", "roles": ["farmer", "farmLandlord", "seller", "equipmentRental", "broker"], "request": {"totalCost": "int", "expectedYieldQuintals": "double"}, "response": {"minSafePricePerQuintal": "int"}},
    {"group": "diary", "method": "GET", "path": "/diary/entries", "description": "Farm diary entries", "roles": ["farmer", "farmLandlord"], "request": {"query": "type, category, from, to"}, "entity": "FarmDiaryEntry"},
    {"group": "diary", "method": "POST", "path": "/diary/entries", "description": "Add diary entry (+15 coins)", "roles": ["farmer", "farmLandlord"], "request": {"title": "string", "category": "string", "type": "expense|income|farmActivity", "amount": "double", "date": "string", "cropName": "string", "notes": "string"}, "response": {"entry": "FarmDiaryEntry", "agriCoinsEarned": 15}, "source": "AppState.addDiaryEntry"},
    {"group": "diary", "method": "DELETE", "path": "/diary/entries/{id}", "description": "Delete diary entry", "roles": ["farmer", "farmLandlord"], "source": "AppState.deleteDiaryEntry"},
    {"group": "diary", "method": "GET", "path": "/diary/report", "description": "PDF report URL", "roles": ["farmer", "farmLandlord"], "request": {"query": "from, to"}},
    {"group": "water", "method": "GET", "path": "/water/schedule", "description": "Plot-wise irrigation schedule", "roles": ["farmer"], "response": [{"plotName": "string", "moisturePercent": "int", "recommendedMinutes": "int", "method": "string"}]},
    {"group": "water", "method": "GET", "path": "/water/groundwater", "description": "CGWB groundwater gauge", "roles": ["farmer"], "request": {"query": "district"}, "response": {"depthMeters": "double", "zone": "safe|semiCritical|critical", "measuredAt": "string"}},
    {"group": "water", "method": "GET", "path": "/water/canal-rotation", "description": "Canal rotation schedule", "roles": ["farmer"], "request": {"query": "canal"}},
    {"group": "water", "method": "POST", "path": "/water/pmksy-calculator", "description": "PMKSY 55% drip subsidy calculator", "roles": ["farmer"], "request": {"acres": "double"}, "response": {"totalCost": "int", "subsidyPercent": 55, "subsidyAmount": "int", "farmerShare": "int"}},
    {"group": "schemes", "method": "GET", "path": "/schemes", "description": "Govt schemes with server-computed eligibility", "roles": ["farmer", "farmLandlord"], "request": {"query": "category, eligibleOnly"}, "entity": "GovtScheme"},
    {"group": "schemes", "method": "POST", "path": "/schemes/{id}/apply", "description": "In-app scheme application with vault docs", "roles": ["farmer", "farmLandlord"], "request": {"documentIds": ["string"]}, "source": "AppState.applyForScheme"},
    {"group": "schemes", "method": "GET", "path": "/schemes/portals", "description": "Official portal map (PM-KISAN, PMFBY, SHC, PM-KUSUM, eNAM)", "roles": ["farmer", "farmLandlord"]},
    {"group": "vault", "method": "GET", "path": "/vault/documents", "description": "List encrypted vault documents", "roles": ["all"]},
    {"group": "vault", "method": "POST", "path": "/vault/documents", "description": "Upload document (multipart, AES-256 at rest)", "roles": ["all"], "request": {"type": "aadhaar|712|passbook|soilHealthCard", "file": "multipart"}, "notes": "Never log Aadhaar numbers"},
    {"group": "vault", "method": "DELETE", "path": "/vault/documents/{id}", "description": "Delete vault document", "roles": ["all"]},
    {"group": "finance", "method": "GET", "path": "/finance/credit-score", "description": "Kisan credit score card", "roles": ["all"], "response": {"kisanCreditScore": "int", "creditTier": "string", "creditLimit": "int", "factors": ["string"]}},
    {"group": "finance", "method": "POST", "path": "/finance/loan-calculator", "description": "Input-loan EMI calculator", "roles": ["all"], "request": {"amount": "int (5000-50000)", "tenureMonths": "int (3-12)", "interestRate": "double (7)"}, "response": {"emi": "int", "totalInterest": "int", "totalPayable": "int"}},
    {"group": "finance", "method": "GET", "path": "/finance/kcc", "description": "Kisan Credit Card details", "roles": ["farmer"], "response": {"bankName": "string", "cardNumberMasked": "string", "kccLimit": "int", "availableLimit": "int"}},
    {"group": "finance", "method": "POST", "path": "/finance/loans/apply", "description": "Input-loan application", "roles": ["farmer"], "request": {"amount": "int", "tenureMonths": "int", "purpose": "string"}},
    {"group": "insurance", "method": "GET", "path": "/insurance/policies", "description": "Digital policy passbook (PMFBY/RWBCIS)", "roles": ["farmer", "farmLandlord"], "entity": "CropInsurancePolicy"},
    {"group": "insurance", "method": "POST", "path": "/insurance/policies/apply", "description": "Quick-apply new crop coverage", "roles": ["farmer", "farmLandlord"], "request": {"cropName": "string", "season": "kharif|rabi|annual", "landAreaAcres": "double"}},
    {"group": "insurance", "method": "GET", "path": "/insurance/policies/{id}/certificate", "description": "e-Certificate PDF download URL", "roles": ["farmer", "farmLandlord"], "source": "AppState.downloadPolicyCertificate"},
    {"group": "insurance", "method": "GET", "path": "/insurance/rates", "description": "Premium rates for calculator", "roles": ["farmer", "farmLandlord"], "request": {"query": "season, crop"}, "entity": "CropPremiumRate"},
    {"group": "insurance", "method": "POST", "path": "/insurance/claims", "description": "72h claim intimation; auto claim number CLM-YYYY-ST-####, status intimated, surveyor assigned", "roles": ["farmer", "farmLandlord"], "request": {"policyId": "string", "cropName": "string", "calamityType": "string", "dateOfDamage": "string", "cropStage": "string", "estimatedLossPercent": "int", "gpsCoordinates": "string", "village": "string", "damagePhotos": "multipart[]"}, "entity": "InsuranceClaimRecord", "source": "AppState.submitCropClaim"},
    {"group": "insurance", "method": "GET", "path": "/insurance/claims", "description": "Claim list", "roles": ["farmer", "farmLandlord"], "entity": "InsuranceClaimRecord"},
    {"group": "insurance", "method": "GET", "path": "/insurance/claims/{id}", "description": "Claim tracker (timeline, surveyor contact, DBT transaction)", "roles": ["farmer", "farmLandlord"], "entity": "InsuranceClaimRecord"},
    {"group": "land", "method": "GET", "path": "/land-records/search", "description": "7/12 & 8A search by Gat number or village (mahabhulekh/Aaple Sarkar)", "roles": ["farmer", "farmLandlord"], "request": {"query": "gatNumber (alnum 1-20), village (min 3, fuzzy), district, type=712|8A"}, "entity": "LandRecord712", "notes": "Multi-match disambiguation; extensible to GJ/KA/UP", "source": "AppState.search712Records"},
    {"group": "land", "method": "GET", "path": "/land-records/{id}/pdf", "description": "Official record PDF (view/download/share)", "roles": ["farmer", "farmLandlord"]},
    {"group": "land", "method": "POST", "path": "/land-records/{id}/import", "description": "Auto-store area/owner/soil/crop-history into farm profile & P&L", "roles": ["farmer", "farmLandlord"]},
    {"group": "equipment", "method": "GET", "path": "/equipment", "description": "Bookable machines near user", "roles": ["farmer", "equipmentRental"], "request": {"query": "type, lat, lng"}},
    {"group": "equipment", "method": "GET", "path": "/equipment/{id}/slots", "description": "Yantra time slots (4 default 4h slots, owner-configurable)", "roles": ["farmer", "equipmentRental"], "request": {"query": "date, week"}, "entity": "YantraSlot"},
    {"group": "equipment", "method": "POST", "path": "/equipment/slots/{id}/book", "description": "Book slot; max 2/farmer/day (409), FPO auto-confirm, private pending, +50 coins", "roles": ["farmer"], "response": {"booking": "object", "status": "confirmed|pending|waitlisted", "agriCoinsEarned": 50}, "source": "AppState.bookYantraSlot"},
    {"group": "equipment", "method": "DELETE", "path": "/equipment/bookings/{id}", "description": "Cancel <=2h before start; SMS to owner", "roles": ["farmer"]},
    {"group": "equipment", "method": "POST", "path": "/equipment/slots/{id}/waitlist", "description": "Join slot waitlist", "roles": ["farmer"]},
    {"group": "equipment", "method": "GET", "path": "/equipment/owner/fleet", "description": "Owner fleet status (bookings, fares, utilization)", "roles": ["equipmentRental"]},
    {"group": "equipment", "method": "POST", "path": "/equipment", "description": "Owner: add machine", "roles": ["equipmentRental"]},
    {"group": "equipment", "method": "PUT", "path": "/equipment/{id}", "description": "Owner: manage machine & slot templates", "roles": ["equipmentRental"]},
    {"group": "fpo", "method": "GET", "path": "/fpo/me", "description": "FPO profile (name, memberCount, district)", "roles": ["farmer"]},
    {"group": "fpo", "method": "GET", "path": "/fpo/pools", "description": "Bulk procurement pools (group buy)", "roles": ["farmer"], "response": [{"id": "string", "item": "string", "bookedUnits": "int", "targetUnits": "int", "discountPercent": "int", "deadline": "string"}]},
    {"group": "fpo", "method": "POST", "path": "/fpo/pools/{id}/join", "description": "Join group buy", "roles": ["farmer"], "request": {"units": "int"}},
    {"group": "fpo", "method": "GET", "path": "/fpo/machinery", "description": "Shared machinery calendar", "roles": ["farmer"], "request": {"query": "week"}},
    {"group": "livestock", "method": "GET", "path": "/gaushalas", "description": "Gaushala directory", "roles": ["farmer", "seller"], "request": {"query": "district, lat, lng"}, "entity": "GaushalaItem"},
    {"group": "livestock", "method": "POST", "path": "/gaushalas/{id}/manure-order", "description": "Order cow-dung manure/slurry", "roles": ["farmer"], "request": {"product": "string", "quantity": "int"}, "source": "AppState.orderGaushalaManure"},
    {"group": "livestock", "method": "GET", "path": "/nurseries", "description": "Plant nursery directory", "roles": ["farmer", "seller"], "request": {"query": "lat, lng"}, "entity": "PlantNursery"},
    {"group": "livestock", "method": "GET", "path": "/vets", "description": "Vet doctors (24x7 emergency flag)", "roles": ["farmer"], "request": {"query": "lat, lng, emergency"}, "entity": "VetDoctor"},
    {"group": "livestock", "method": "POST", "path": "/vets/{id}/book", "description": "Book vet (farm visit or clinic, slot)", "roles": ["farmer"], "request": {"visitType": "farm|clinic", "slot": "string", "animalType": "string"}, "source": "AppState.bookVetDoctor"},
    {"group": "livestock", "method": "GET", "path": "/dairy-products", "description": "Dairy marketplace (A2 ghee/milk/paneer)", "roles": ["farmer", "seller"], "request": {"query": "category"}, "entity": "DairyProductItem"},
    {"group": "livestock", "method": "POST", "path": "/dairy-products/{id}/order", "description": "Direct buy dairy product", "roles": ["farmer", "seller"], "request": {"quantity": "double"}, "source": "AppState.orderDairyProduct"},
