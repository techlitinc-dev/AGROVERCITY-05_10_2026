APP_NAME=AGROVERCITY API
# Canonical environment selector: ENV (APP_ENV is also accepted). Values: dev | staging | prod.
# staging/prod refuse to boot without a real JWT_SECRET and Razorpay keys.
ENV=dev
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=agrovercity-dev
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=30
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AI gateway: live | shim (shim = deterministic fixtures; use shim in dev/test/CI).
AI_PROVIDER=shim
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_JEV_MODEL=typesafe/jev-1.13
AI_GEMINI_MODEL=gemini-3.8-flash
AI_GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Crop planner pins the fastest verified flash model (progress-bar UX).
AI_GEMINI_MODEL_PLAN=gemini-3.5-flash
# Leaf-clinic vision scans pin a flash-class model (progress-animation UX).
AI_GEMINI_MODEL_VISION=gemini-3.5-flash
AI_GEMINI_MODEL_PRO=gemini-2.5-pro
AI_GEMINI_EMBED_MODEL=gemini-embedding-001
AI_DAILY_BUDGET_USD=50
AI_HASH_SALT=
# Per-1M-token cost accounting rates (USD; defaults = published list input rates).
# Override when OpenRouter/Gemini list pricing changes — no code change needed.
AI_COST_JEV_PER_1M=0.042
AI_COST_GEMINI_PER_1M=0.30
AI_COST_GEMINI_LITE_PER_1M=0.10
SARVAM_API_KEY=
WEATHER_API_KEY=
# Google Maps geo provider (geocode/route/autocomplete); empty = mock mode.
# GOOGLE_MAPS_API_KEY=
# Real DSN comes from the Sentry project settings; leave empty in dev.
SENTRY_DSN=
# JSON array of allowed web origins; staging/prod list the real domains.
WEB_ORIGINS=["http://localhost:5173"]
# Dairy SMS/WhatsApp slip gateway (WS-01 Task 1.26)
SMS_GATEWAY_API_KEY=
WHATSAPP_API_KEY=
# SMS fallback provider (phase-06 WS-02): msg91 | twilio | stub (default stub)
SMS_PROVIDER=stub
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Government open-data mandi price feed (data.gov.in via techlitinc.in PHP proxy).
# Base URL only — the backend appends /mandi_prices.php.
MANDI_GOV_DATA_BASE_URL=https://techlitinc.in/mandi_api
