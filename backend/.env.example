APP_NAME=AGROVERCITY API
# Canonical environment selector: ENV (APP_ENV is also accepted). Values: dev | staging | prod.
# staging/prod refuse to boot without a real JWT_SECRET and Razorpay keys.
ENV=dev
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=agrovercity-bafec
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=30
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AI gateway: live | shim (shim = deterministic fixtures; use shim in dev/test/CI).
AI_PROVIDER=shim
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_JEV_MODEL=typesafe/jev-1.13
AI_GEMINI_MODEL=gemini-3.8-flash
AI_GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Crop planner pins the fastest verified flash model (progress-bar UX).
AI_GEMINI_MODEL_PLAN=gemini-3.5-flash
# Leaf-clinic vision scans pin a flash-class model (progress-animation UX).
AI_GEMINI_MODEL_VISION=gemini-3.5-flash
AI_GEMINI_MODEL_PRO=gemini-2.5-pro
AI_GEMINI_EMBED_MODEL=gemini-embedding-001
AI_DAILY_BUDGET_USD=50
AI_HASH_SALT=
# Per-1M-token cost accounting rates (USD; defaults = published list input rates).
# Override when OpenRouter/Gemini list pricing changes — no code change needed.
AI_COST_JEV_PER_1M=0.042
AI_COST_GEMINI_PER_1M=0.30
AI_COST_GEMINI_LITE_PER_1M=0.10
SARVAM_API_KEY=
WEATHER_API_KEY=
# Google Maps geo provider (geocode/route/autocomplete); empty = mock mode.
# GOOGLE_MAPS_API_KEY=
# Real DSN comes from the Sentry project settings; leave empty in dev.
SENTRY_DSN=
# JSON array of allowed web origins; staging/prod list the real domains.
WEB_ORIGINS=["http://localhost:5173"]
# Dairy SMS/WhatsApp slip gateway (WS-01 Task 1.26)
SMS_GATEWAY_API_KEY=
WHATSAPP_API_KEY=
# SMS fallback provider (phase-06 WS-02): msg91 | twilio | stub (default stub)
SMS_PROVIDER=stub
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Government open-data mandi price feed (data.gov.in via techlitinc.in PHP proxy).
# Base URL only — the backend appends /mandi_prices.php.
MANDI_GOV_DATA_BASE_URL=https://techlitinc.in/mandi_api

# Identity verification (KYC) provider: mock | sandbox.
# mock    = internal mock DigiLocker screen (default; dev / no-SSL testing
#           servers). Never asks for a DigiLocker password, Aadhaar OTP, or
#           real Aadhaar details.
# sandbox = real DigiLocker consent flow through the Sandbox.co.in KYC API:
#           consent redirect, document pull (Aadhaar XML / PAN / DL), storage.
#           Flip KYC_PROVIDER=sandbox and fill SANDBOX_API_* below to activate.
KYC_PROVIDER=mock
# Restricted onboarding-token TTL for the registration/KYC journey (minutes).
KYC_ONBOARDING_TTL_MINUTES=30
# Public base URL of the web app — KYC registration callback URLs point here.
# On the public no-SSL testing server set the host:port explicitly:
# WEB_APP_BASE_URL=http://65.20.92.22:5173
WEB_APP_BASE_URL=http://localhost:5173
# Sandbox.co.in KYC API (only used when KYC_PROVIDER=sandbox).
# Get keys at https://console.sandbox.co.in → Settings → API Keys.
# Test environment: https://test-api.sandbox.co.in (key_test_... credentials).
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_API_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_VERSION=1.0
SANDBOX_API_TIMEOUT_SECONDS=20
# Public HTTPS base of THIS backend — Sandbox redirects the user's browser to
# {base}/v1/kyc/sessions/oauth/callback after DigiLocker consent. Must be a
# publicly reachable HTTPS URL for the real flow to complete.
SANDBOX_API_REDIRECT_BASE=
