rules_version = '2';
// PRODUCTION — deny-all. The backend is the only writer/reader of Firestore,
// via the Firebase Admin SDK (bypasses these rules entirely). Mobile/web
// clients never touch Firestore; they use the REST API only, and every
// per-collection authorization rule is enforced in backend/app/services/.
// See docs/schema/firestore-collections.md "Global rules".
//
// The root ./firestore.rules is permissive (allow read, write: if true) and
// is wired to the local emulator via firebase.json — dev-only, never deploy.
// Deploy THIS file instead: firebase deploy --only firestore:rules
// (or set `firestore.rules` in firebase.json to infra/firestore.rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
